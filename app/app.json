{
  "expo": {
    "name": "Patchwork",
    "slug": "todo",
    "version": "1.14.0",
    "platforms": ["ios", "android"],
    "orientation": "default",
    "icon": "./assets/images/icon.png",
    "scheme": "patchwork",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "supportsTablet": true,
      "requireFullScreen": false
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FAF1E6",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": true,
      "softwareKeyboardLayoutMode": "resize"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FAF1E6",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "dark": {
            "backgroundColor": "#1C161F",
            "image": "./assets/images/splash-icon-dark.png",
            "imageWidth": 180
          }
        }
      ],
      "@react-native-community/datetimepicker",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow $(PRODUCT_NAME) to access your photos to import tasks from images.",
          "cameraPermission": "Allow $(PRODUCT_NAME) to use the camera to capture notes for task import."
        }
      ],
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": true,
          "faceIDPermission": "Allow $(PRODUCT_NAME) to access saved credentials."
        }
      ],
      "expo-notifications",
      [
        "expo-calendar",
        {
          "calendarPermission": "$(PRODUCT_NAME) shows your calendar events next to your to-dos and can add to-dos with dates to your calendar.",
          "remindersPermission": "$(PRODUCT_NAME) shows your Reminders lists as to-do lists and saves your changes back to them."
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Patchwork uses the microphone only while you dictate a task.",
          "recordAudioAndroid": true
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow $(PRODUCT_NAME) to use the camera to scan QR codes of shared lists.",
          "recordAudioAndroid": false,
          "microphonePermission": false
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow $(PRODUCT_NAME) to use Face ID to unlock the app."
        }
      ],
      "expo-sharing",
      [
        "expo-document-picker",
        {
          "iCloudContainerEnvironment": "Production"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "ca5c1bfd-31d3-484f-a189-57ced9330266"
      }
    }
  }
}
