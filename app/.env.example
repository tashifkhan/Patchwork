CALDAV_TEST_URL=https://drive.example.com/remote.php/dav/calendars/username/
CALDAV_TEST_USERNAME=username
CALDAV_TEST_PASSWORD=app-password

# Optional: GitHub App client ID (Settings → GitHub).
# Create a GitHub App with Device Flow enabled and repository Metadata (read)
# plus Issues (read/write). If unset, users can still use public repositories
# or connect with a fine-grained Personal Access Token.
EXPO_PUBLIC_GITHUB_CLIENT_ID=
