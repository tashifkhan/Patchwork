<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application>
        <!-- Android indexes these AppFunctions for callers the system allows to run them
             (Gemini and other assistants, Android 16+). The service class is generated by
             the AppFunctions KSP compiler from PatchworkAppFunctions. Gemini also needs a
             Connected Apps registration for this package before it lists Patchwork. -->
        <service
            android:name="expo.modules.patchworkshortcuts.PatchworkAppFunctionService"
            android:exported="true"
            android:permission="android.permission.BIND_APP_FUNCTION_SERVICE"
            tools:targetApi="36">
            <property
                android:name="android.app.appfunctions.schema"
                android:value="app_functions_schema.xsd" />
            <property
                android:name="android.app.appfunctions.v2"
                android:value="patchwork_app_functions.xml" />
            <intent-filter>
                <action android:name="android.app.appfunctions.AppFunctionService" />
            </intent-filter>
        </service>
        <property
            android:name="android.app.appfunctions.app_metadata"
            android:resource="@xml/patchwork_app_function_metadata"
            tools:targetApi="36" />
    </application>
</manifest>
