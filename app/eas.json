{
  "cli": {
    "version": ">= 10.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "simulator": true
      },
      "env": {
        "APP_VARIANT": "development"
      }
    },
    "production": {
      "env": {
        "APP_VARIANT": "production"
      }
    },
    "github-release": {
      "environment": "production",
      "distribution": "store",
      "autoIncrement": true,
      "android": {
        "buildType": "apk",
        "gradleCommand": ":app:assembleRelease"
      },
      "env": {
        "APP_VARIANT": "production",
        "NODE_ENV": "production"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
